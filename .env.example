# Optional Gemini API Key for AI-powered implementation briefs
# If omitted or left blank, ContextPilot operates seamlessly using its
# built-in deterministic rule-based engineering engine.
GEMINI_API_KEY=

# Optional open-weight local model, served by Ollama (no API key required).
# Install Ollama, run `ollama serve`, then `ollama pull <model>`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional Alan AI project key (public client key from Alan AI Studio).
# Requires a deployed Alan Studio dialog script that sends `prefillTask`.
ALAN_PROJECT_KEY=